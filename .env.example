NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Embedding model (HF local, ~600MB cold-download)
EMBED_MODEL=Xenova/bge-m3
EMBED_DIM=1024

# Paths (opcionais — defaults dinâmicos baseados no seu $HOME)
#   CLAUDE_HOME default: ~/.claude
#   CODE_HOME   default: ~/Documents/code
#   CACHE_DIR   default: ~/.cache/mcp-talks-cc
# Descomente só se seus diretórios fugirem do padrão.
# CLAUDE_HOME=
# CODE_HOME=
# CACHE_DIR=

# OpenRouter (FASE F opcional - nao usado no MVP)
# OPENROUTER_API_KEY=
